rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 연구자 Google 계정 (웹앱의 ADMIN_EMAILS 목록과 똑같이 맞춰 주세요)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'hoonse00000@gmail.com',
          'sw.almond06@gmail.com',
          'gigayu7@gmail.com',
          'kangminkim121106@gmail.com',
          'binn121015@gmail.com'
        ];
    }
    function signedIn() { return request.auth != null; }

    // 설문 문항과 시작 화면 문구: 누구나 읽기, 연구자만 수정
    match /surveys/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 참여자 응답
    // - 웹앱에 접속한 사람(익명 로그인 포함)은 응답을 만들고 이어서 저장할 수 있어요.
    // - 응답 목록을 보거나 지우는 것은 연구자만 할 수 있어요.
    // - 응답 문서 주소는 무작위라서 다른 사람의 응답을 찾아 고칠 수 없어요.
    match /records/{id} {
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
      allow read, delete: if isAdmin();
    }
  }
}
